rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function friendshipId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + "__" + uid2 : uid2 + "__" + uid1;
    }

    function areFriends(uid1, uid2) {
      let friendshipPath = /databases/$(database)/documents/friendships/$(friendshipId(uid1, uid2));
      return exists(friendshipPath)
        && get(friendshipPath).data.participants.hasAll([uid1, uid2]);
    }

    function isGroupMember(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      return signedIn()
        && exists(groupPath)
        && request.auth.uid in get(groupPath).data.memberIds;
    }

    function isCallMember(callId) {
      let callPath = /databases/$(database)/documents/calls/$(callId);
      return signedIn()
        && exists(callPath)
        && request.auth.uid in get(callPath).data.participantIds;
    }

    function isConnectionMember(callId, connectionId) {
      let connectionPath = /databases/$(database)/documents/calls/$(callId)/connections/$(connectionId);
      return isCallMember(callId)
        && exists(connectionPath)
        && request.auth.uid in get(connectionPath).data.participants;
    }

    function validConversation(conversationId, data) {
      return data.participants is list
        && data.participants.size() == 2
        && data.participants[0] < data.participants[1]
        && conversationId == data.participants[0] + "__" + data.participants[1]
        && request.auth.uid in data.participants
        && areFriends(data.participants[0], data.participants[1]);
    }

    function validCallCreate(data) {
      return signedIn()
        && data.keys().hasOnly([
          "callerId", "participantIds", "participantNames", "type", "title",
          "conversationId", "groupId", "status", "createdAt"
        ])
        && data.callerId == request.auth.uid
        && data.participantIds is list
        && data.participantIds.size() >= 2
        && data.participantIds.size() <= 6
        && request.auth.uid in data.participantIds
        && data.participantNames is map
        && data.type in ["audio", "video"]
        && data.title is string
        && data.title.size() <= 120
        && data.status == "active"
        && data.createdAt is timestamp
        && (
          (
            data.groupId is string
            && data.conversationId == null
            && exists(/databases/$(database)/documents/groups/$(data.groupId))
            && get(/databases/$(database)/documents/groups/$(data.groupId)).data.memberIds.size() == data.participantIds.size()
            && get(/databases/$(database)/documents/groups/$(data.groupId)).data.memberIds.hasAll(data.participantIds)
            && data.participantIds.hasAll(get(/databases/$(database)/documents/groups/$(data.groupId)).data.memberIds)
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(data.groupId)).data.memberIds
          )
          || (
            data.groupId == null
            && data.conversationId is string
            && exists(/databases/$(database)/documents/conversations/$(data.conversationId))
            && get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.participants.size() == data.participantIds.size()
            && get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.participants.hasAll(data.participantIds)
            && data.participantIds.hasAll(get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.participants)
            && data.participantIds.size() == 2
            && areFriends(data.participantIds[0], data.participantIds[1])
          )
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "displayName", "email", "gender", "dateOfBirth",
          "username", "createdAt", "updatedAt", "photoURL", "photoPublicId",
          "photoResourceType", "photoFormat", "photoBytes", "mediaProvider",
          "media", "about", "theme", "messageNotifications", "friendNotifications",
          "groupNotifications", "onlineStatus", "readReceipts", "discoverability", "status"
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "displayName", "email", "gender", "dateOfBirth",
          "username", "createdAt", "updatedAt", "photoURL", "photoPublicId",
          "photoResourceType", "photoFormat", "photoBytes", "mediaProvider",
          "media", "about", "theme", "messageNotifications", "friendNotifications",
          "groupNotifications", "onlineStatus", "readReceipts", "discoverability", "status"
        ]);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "displayName", "username", "about", "photoURL", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "senderId", "receiverId", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.auth.uid == resource.data.receiverId
            && request.resource.data.status in ["accepted", "declined"]
          )
          || (
            request.auth.uid == resource.data.senderId
            && request.resource.data.status == "cancelled"
          )
        );
      allow delete: if false;
    }

    match /friendships/{friendshipIdValue} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && friendshipIdValue == friendshipId(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.requestId is string
        && request.resource.data.createdAt is timestamp
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == "accepted"
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.participants
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.receiverId in request.resource.data.participants;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && validConversation(conversationId, request.resource.data)
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageAt", "lastMediaURL", "updatedAt"
        ])
        && (!request.resource.data.keys().hasAny(["lastMessage"]) || request.resource.data.lastMessage is string)
        && (!request.resource.data.keys().hasAny(["lastMediaURL"]) || request.resource.data.lastMediaURL is string);
      allow delete: if false;

      match /messages/{messageId} {
        function isConversationMember() {
          let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
          return signedIn()
            && exists(conversationPath)
            && request.auth.uid in get(conversationPath).data.participants;
        }

        allow read: if isConversationMember();
        allow create: if isConversationMember()
          && request.resource.data.keys().hasOnly([
            "senderId", "text", "type", "createdAt", "mediaURL", "publicId",
            "resourceType", "format", "bytes", "provider"
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.type in ["text", "image", "video", "audio"]
          && request.resource.data.createdAt is timestamp
          && (
            request.resource.data.type == "text"
            || request.resource.data.mediaURL is string
          );
        allow update, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name", "memberIds", "participants", "createdBy", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == request.resource.data.memberIds.size()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt"])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 5000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly(["senderId", "senderName", "text", "createdAt"])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if validCallCreate(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.auth.uid == resource.data.callerId
        && resource.data.status == "active"
        && request.resource.data.status == "ended"
        && request.resource.data.endedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "endedAt"]);
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if isCallMember(callId);
        allow create, update: if isCallMember(callId)
          && request.auth.uid == participantId
          && request.resource.data.uid == participantId
          && request.resource.data.state in ["active", "declined", "left"]
          && request.resource.data.keys().hasOnly([
            "uid", "displayName", "state", "joinedAt", "updatedAt", "leftAt"
          ]);
        allow delete: if false;
      }

      match /connections/{connectionId} {
        allow read: if isCallMember(callId)
          && request.auth.uid in resource.data.participants;
        allow create: if isCallMember(callId)
          && request.auth.uid == request.resource.data.offererId
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants
          && get(/databases/$(database)/documents/calls/$(callId)).data.participantIds.hasAll(request.resource.data.participants)
          && request.resource.data.offer is map
          && request.resource.data.offer.type == "offer"
          && request.resource.data.offer.sdp is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            "participants", "offererId", "offer", "createdAt"
          ]);
        allow update: if isCallMember(callId)
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.offererId == resource.data.offererId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["offer", "answer", "createdAt"])
          && (
            (
              request.auth.uid == resource.data.offererId
              && request.resource.data.offer is map
              && request.resource.data.offer.type == "offer"
              && request.resource.data.offer.sdp is string
            )
            || (
              request.auth.uid != resource.data.offererId
              && request.resource.data.answer is map
              && request.resource.data.answer.type == "answer"
              && request.resource.data.answer.sdp is string
            )
          );
        allow delete: if false;

        match /callerCandidates/{candidateId} {
          allow read: if isConnectionMember(callId, connectionId);
          allow create: if isConnectionMember(callId, connectionId)
            && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)/connections/$(connectionId)).data.offererId;
          allow update, delete: if false;
        }

        match /calleeCandidates/{candidateId} {
          allow read: if isConnectionMember(callId, connectionId);
          allow create: if isConnectionMember(callId, connectionId)
            && request.auth.uid != get(/databases/$(database)/documents/calls/$(callId)/connections/$(connectionId)).data.offererId;
          allow update, delete: if false;
        }
      }
    }
  }
}
